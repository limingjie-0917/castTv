<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦优先：遥控器焦点时黄色描边高亮 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#552FA8C9" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <!-- 选中态：实心填充表示当前所在合集 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#66F6C445" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/crayon_orange" />
        </shape>
    </item>
    <!-- 普通态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221B1F26" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
