<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.1.125 合集管理复选框背景（selector）：
    - state_selected=true：暖黄实心 + 深色对勾
    - state_selected=false：透明底 + 暖黄描边
    使用 shape 自绘，不依赖 Material 组件。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/crayon_yellow" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>
</selector>
