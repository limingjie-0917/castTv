<?xml version="1.0" encoding="utf-8"?>
<!--
    深灰主题下通用可聚焦按钮背景（设置页原样式）：
    - 默认态：深灰面板 + 白色虚线细描边
    - 选中态：透明底 + 无边框，文字/图标由 selector 变暖黄
    - 焦点态：透明底 + 暖黄实线边框
    - 选中+焦点态：透明底 + 暖黄实线边框
    经典主题会通过 setTheme(Classic) 切换到 bg_dialog_focus_item_classic。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/crayon_orange" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221B1F26" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF"
                android:dashWidth="7dp"
                android:dashGap="4dp" />
        </shape>
    </item>

</selector>
