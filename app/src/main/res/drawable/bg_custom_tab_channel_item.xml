<?xml version="1.0" encoding="utf-8"?>
<!--
    自定义 Tab 频道列表项四态背景：
    - 默认态：浅灰色实线边框 + 半透明亮灰色背景
    - 选中态：边框/背景保持默认，文字由 selector 变暖黄
    - 焦点态：暖黄色实线边框，背景保持默认
    - 选中+焦点态：与焦点态背景叠加选中文字色
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#223A3F48" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#223A3F48" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#66E8EAED" />
        </shape>
    </item>

</selector>
