<?xml version="1.0" encoding="utf-8"?>
<!-- 「☁️ 云端共享」列表单条卡片背景：深色圆角，蜡笔黄描边，与收藏页弹窗主题一致。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26F6C445" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1F27" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#33F6C445" />
        </shape>
    </item>
</selector>
