<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义 Tab 预览区专用背景：视觉与 bg_dialog_input 一致（深色纯色 + 暖黄描边 + 14dp 圆角），
  但去掉了内嵌 <padding>，避免作为预览容器背景时给内容加上额外内边距。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#181B22" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#55F6C445" />
</shape>
