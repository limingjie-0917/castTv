<?xml version="1.0" encoding="utf-8"?>
<!--
  批量操作悬浮菜单 Icon 背景（零 Material 依赖）：
  - 默认态：白色实线边框，无背景色。
  - 选中/焦点/按压态：暖蜡笔黄实线边框，无虚线、无透明描边抖动。
  Icon 本体的暖黄/白色 tint 由 color/batch_menu_fab_icon_tint.xml 状态色配合实现。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

</selector>
