<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#44F6C445" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FF8C42" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/crayon_orange" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22F6C445" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#88F6C445" />
        </shape>
    </item>
</selector>
