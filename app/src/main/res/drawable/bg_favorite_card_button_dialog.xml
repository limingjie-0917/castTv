<?xml version="1.0" encoding="utf-8"?>
<!-- 非 Grid 视频卡片按钮背景：默认保持原 bg_dialog_focus_item 观感；选中/焦点/按下改为暖黄色小圆角边框。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#332FA8C9" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#332FA8C9" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#442E63C4" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221B1F26" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF"
                android:dashWidth="7dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</selector>
