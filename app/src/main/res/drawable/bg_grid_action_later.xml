<?xml version="1.0" encoding="utf-8"?>
<!-- 收藏网格「稍后」小按钮：焦点态蓝色描边，普通态半透明蓝底 + 暖黄细描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#334089FD" /><corners android:radius="10dp" /><stroke android:width="2dp" android:color="@color/crayon_yellow" android:dashWidth="7dp" android:dashGap="4dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#222E63C4" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#66F6C445" /></shape></item>
</selector>
