<?xml version="1.0" encoding="utf-8"?>
<!--
    深灰主题下收藏内容网格卡片背景（v1.1.116+）：
    - 焦点态：暖黄描边 + 暖黄透明底（参考批量操作弹窗小视频卡片四态）
    - 选中态：浅暖黄描边 + 更淡暖黄底
    - 默认态：深灰面板 + 细白色描边
    经典主题会通过 setTheme(Classic) 切换到 bg_favorite_grid_card_classic。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F6C445" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/crayon_yellow" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFD080" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="#FFD080" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151920" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
