<?xml version="1.0" encoding="utf-8"?>
<!--
    「系统提示气泡」浅色玻璃拟态背景：
    - 白色到浅灰色的纵向渐变，保留轻盈的玻璃质感；
    - 仅做轻微透明度处理，能隐约透出背景，但不呈现明显半透明；
    - 大圆角 + 柔和浅色描边，维持悬浮系统横幅的精致感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F8FFFFFF"
                android:centerColor="#F6FCFCFD"
                android:endColor="#F0EEF2F5"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#96FFFFFF"
                android:centerColor="#42FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="16dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:centerColor="#0CE5E7EB"
                android:endColor="#18D9DDE3"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
