<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#553E9BE8"
                android:centerColor="#334089FD"
                android:endColor="#2214171C"
                android:angle="135" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2.5dp"
                android:color="#F6C445"
                android:dashWidth="7dp"
                android:dashGap="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#552E63C4" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="#F2913D"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3014171C"
                android:centerColor="#221B1F26"
                android:endColor="#140B0F1A"
                android:angle="135" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#66F6C445" />
        </shape>
    </item>
</selector>
