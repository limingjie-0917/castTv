<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_favorites_dialog_root_crayon"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingTop="24dp"
    android:paddingRight="32dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dialog_crayon_header"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="📡 直播源预览"
        android:textColor="#101217"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/importLivePreviewSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/importLivePreviewQuotaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:textColor="@color/crayon_yellow"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_crayon_dot"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="将要创建 / 更新的合集"
        android:textColor="@color/crayon_yellow"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_input"
        android:fillViewport="false"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/importLivePreviewList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="同名合集会覆盖更新；未勾选的分组会跳过。"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnToggleAllImportLivePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_focus_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/btnCancelImportLivePreview"
            android:nextFocusDown="@id/btnToggleAllImportLivePreview"
            android:paddingLeft="18dp"
            android:paddingTop="11dp"
            android:paddingRight="18dp"
            android:paddingBottom="11dp"
            android:text="取消全选"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelImportLivePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_focus_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btnToggleAllImportLivePreview"
            android:nextFocusRight="@id/btnConfirmImportLivePreview"
            android:nextFocusDown="@id/btnCancelImportLivePreview"
            android:paddingLeft="18dp"
            android:paddingTop="11dp"
            android:paddingRight="18dp"
            android:paddingBottom="11dp"
            android:text="取消"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmImportLivePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_focus_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btnCancelImportLivePreview"
            android:nextFocusDown="@id/btnConfirmImportLivePreview"
            android:paddingLeft="20dp"
            android:paddingTop="11dp"
            android:paddingRight="20dp"
            android:paddingBottom="11dp"
            android:text="🖍 导入选中分组"
            android:textColor="@color/crayon_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
