<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        视频渲染面：同时预置两个 PlayerView，运行时按 Settings.useSurfaceView 只显示其中一个。
        - playerView（SurfaceView）：默认关闭，用户主动开启后使用；硬解性能略强，但部分 TV
          机型 PixelCopy 会拿到黑图，导致缩略图失败。
        - playerViewTexture（TextureView）：默认使用，兼容性更好，且能稳定用
          `TextureView.getBitmap()` 生成缩略图。
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="texture_view" />

    <!-- AirPlay mirroring surface (hidden until a mirror session starts) -->
    <com.bd.casttv.airplay.PlaySurfaceView
        android:id="@+id/mirrorSurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 右侧菜单的二级「稍后播放」面板：紧贴菜单左侧弹出。 -->
    <LinearLayout
        android:id="@+id/queuePanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="300dp"
        android:background="@drawable/bg_queue_panel"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="28dp"
        android:paddingRight="22dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_crayon_header"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:text="稍后播放"
            android:textColor="#101217"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="像切电视台一样，上下选择，OK 立即切换"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/textQueueHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="返回收起 · 当前播放会高亮"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Top-left source overlay: "来自 爱奇艺 - 《狂飙》第3集" -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_gradient"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/imgSourceApp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:contentDescription="source" />

        <TextView
            android:id="@+id/textSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <!-- Center buffering / status -->
    <LinearLayout
        android:id="@+id/centerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBuffering"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/textCenterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/player_buffering"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 音量浮层（自动隐藏）：遥控器上下/音量键调节 ExoPlayer 音量时可见反馈。 -->
    <LinearLayout
        android:id="@+id/volumeOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgVolume"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/player_volume"
            android:src="@drawable/ic_volume"
            android:tint="@color/text_primary" />

        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="8dp"
            android:layout_marginStart="18dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/textVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:minWidth="48dp"
            android:gravity="end"
            android:text="100%"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bottom control bar (auto-hide) -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="60dp"
        android:paddingBottom="32dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textPlayState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ 播放中"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:text="OK 播放/暂停 · 左右 快退/快进 · 上下 音量 · 频道+/列表 稍后播放 · 菜单 收藏 · 返回 退出"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 菜单键呼出的右侧侧边弹窗（含收藏按钮），默认隐藏，蜡笔小新主题。 -->
    <LinearLayout
        android:id="@+id/sidebarPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_sidebar_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_crayon_header"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:text="@string/sidebar_title"
            android:textColor="#101217"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_crayon_stripe" />

        <LinearLayout
            android:id="@+id/btnSidebarFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_player_sidebar_action"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_dock_favorite"
                android:tint="@color/player_sidebar_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:duplicateParentState="true"
                android:text="@string/btn_favorite"
                android:textColor="@color/player_sidebar_action_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSidebarQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_player_sidebar_action"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_player_queue"
                android:tint="@color/player_sidebar_action_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:duplicateParentState="true"
                android:text="稍后播放列表"
                android:textColor="@color/player_sidebar_action_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sidebar_subtitle"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 方案 1：进入播放器时短暂展示"正在接收投屏"横幅，1.5s 后淡出；
         全链路不参与焦点/点击，覆盖在最上层。 -->
    <LinearLayout
        android:id="@+id/playerCastReceivingBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_cast_banner"
        android:clickable="false"
        android:duplicateParentState="false"
        android:elevation="14dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="14dp"
        android:paddingRight="24dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:focusable="false"
            android:text="📡"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/playerCastReceivingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:letterSpacing="0.02"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
