<?xml version="1.0" encoding="utf-8"?>
<!--
    收藏「导入 / 导出」二维码弹窗（TV 端）。
    - 顶部标题 + 说明文案（导出 / 导入 由代码按模式设置）；
    - 中间白底圆角卡片承载二维码位图（手机扫码后在浏览器打开传输页）；
    - 二维码下方显示可读的访问地址与实时状态（网络变化 / 收到上传等）。
    风格与收藏弹窗一致：蜡笔小新深色主题 + 宝蓝主色 + 蜡笔黄描边。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_favorites_dialog_root_crayon">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:rotation="12"
        android:src="@drawable/ic_crayon_sticker" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="30dp"
        android:paddingRight="32dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/favTransferTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_crayon_header"
            android:drawableStart="@drawable/ic_crayon_dot"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:text="🖍 导出收藏"
            android:textColor="#101217"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/favTransferSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="用手机扫描下方二维码，在浏览器中下载收藏备份文件。"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- 二维码承载卡片（白底，保证扫码识别率） -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_dialog_input"
            android:padding="14dp">

            <ImageView
                android:id="@+id/favTransferQr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="#FFFFFF"
                android:contentDescription="@null"
                android:padding="8dp"
                android:scaleType="fitXY" />
        </FrameLayout>

        <TextView
            android:id="@+id/favTransferUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="http://"
            android:textColor="@color/crayon_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/favTransferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="等待手机扫码连接…"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="请确保手机与电视连接同一 Wi-Fi / 局域网 🌻"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
