<?xml version="1.0" encoding="utf-8"?>
<!--
  手机交互中心弹窗：QR 码 + 状态提示 + 局域网地址。
  主题与 dialog_settings.xml 对齐：bg_dialog_crayon_panel（深色渐变 + 蜡笔黄描边圆角），
  顶部橙-黄-蓝渐变标题条 bg_dialog_crayon_header。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="28dp"
    android:background="@drawable/bg_dialog_crayon_panel"
    android:orientation="vertical"
    android:padding="40dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_crayon_header"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:text="📱 手机交互中心"
        android:textColor="#101217"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="用手机扫描下方二维码，在浏览器中打开手机端页面：\n可查看/编辑收藏、历史，管理稍后播放队列，还能一键推送到电视。"
        android:textColor="#A8B0BE"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_input"
            android:orientation="vertical"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/phoneHubQrCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/phoneHubQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="phone-hub-qrcode"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/phoneHubQrFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="📡\n请先开启 HTTP 服务\n开启后这里会显示二维码"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phoneHubSwitchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dialog_focus_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/phoneHubSwitchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HTTP 服务"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/phoneHubSwitch"
                android:layout_width="51dp"
                android:layout_height="31dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:splitTrack="false"
                android:showText="false"
                android:thumb="@drawable/switch_ios_thumb"
                android:track="@drawable/switch_ios_track"
                android:textOff=""
                android:textOn="" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开后即使关闭弹窗或进入视频播放页，手机端也能继续推送队列和读取播放状态。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔗 局域网地址"
                android:textColor="#F6C445"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneHubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_input"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="http://…"
                android:textColor="#E8EAED"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📌 双写提醒"
                android:textColor="#F6C445"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="收藏数据允许手机端与电视端双写；\n为防止修改覆盖，避免与电视同时编辑。"
                android:textColor="#A8B0BE"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/phoneHubStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="10dp"
                android:background="#221B1F26"
                android:text="⏳ 正在启动服务…"
                android:textColor="#43B97F"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
