<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.1.125 合集管理弹窗内的单行合集项：
    - 左侧：复选框（自绘 View，不使用 Material）
    - 中部：合集名称 + 视频数量
    - 整行可聚焦；焦点/选中态复用 bg_batch_video_card 暖黄描边视觉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collectionManageItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_batch_video_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- 左侧复选框（自绘方块） -->
    <FrameLayout
        android:id="@+id/collectionManageCheckBox"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_collection_manage_checkbox">

        <TextView
            android:id="@+id/collectionManageCheckMark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textColor="#101217"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/collectionManageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="合集名称"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collectionManageItemCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
