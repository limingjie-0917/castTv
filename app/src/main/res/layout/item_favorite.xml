<?xml version="1.0" encoding="utf-8"?>
<!-- 完整收藏列表项：标题+资源地址 + 改名/删除操作按钮，均可遥控器聚焦。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favoriteItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dialog_focus_item"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="⭐"
        android:textSize="18sp" />

    <CheckBox
        android:id="@+id/listSelectBox"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:buttonTint="@color/crayon_yellow"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <!-- 收藏截图缩略图（16:9）；无截图时展示默认兜底图。 -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="68dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/itemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb_frame"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_thumb_default" />

        <TextView
            android:id="@+id/itemLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_live_badge"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="直播"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_favorite_card_button_dialog"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:text="播放"
                android:textColor="@color/favorite_card_button_yellow_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_favorite_card_button_dialog"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:text="改名"
                android:textColor="@color/favorite_card_button_blue_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnMove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_favorite_card_button_dialog"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:text="@string/favorite_move_btn"
                android:textColor="@color/favorite_card_button_green_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_favorite_card_button_dialog"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="14dp"
                android:paddingTop="4dp"
                android:paddingRight="14dp"
                android:paddingBottom="4dp"
                android:text="删除"
                android:textColor="@color/favorite_card_button_delete_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnLater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_favorite_card_button_dialog"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="14dp"
                android:paddingTop="4dp"
                android:paddingRight="14dp"
                android:paddingBottom="4dp"
                android:text="稍后播放"
                android:textColor="@color/favorite_card_button_yellow_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
