    <!-- Tutorials -->
    <string name="tutorial_title">如何投屏</string>
    <string name="service_status_title">服务状态</string>
    <string name="tutorial_iqiyi">爱奇艺：打开视频 → 点击右上角「TV」→ 选择「%1$s」</string>
    <string name="tutorial_bilibili">哔哩哔哩：全屏播放 → 点击「投屏」→ 选择「%1$s」</string>
    <string name="tutorial_tencent">腾讯视频：播放页 → 点击「电视」图标 → 选择「%1$s」</string>
    <string name="tutorial_youku">优酷：播放页 → 点击「TV」→ 选择「%1$s」</string>
    <string name="tutorial_static">通用方式：打开视频 → 点击「TV / 投屏」→ 选择当前电视设备名称</string>
    <string name="tutorial_static_with_name">通用方式：打开视频 → 点击「TV / 投屏」→ 选择「%1$s」</string>

